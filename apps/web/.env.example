# Copy to .dev.vars (read by `wrangler dev` and, through the Cloudflare adapter, by `astro build`).
# `node scripts/dev-vars.mjs <file>` writes it from an env file that uses SHOPIFY_* names.
PUBLIC_STORE_DOMAIN=
# PUBLIC_STOREFRONT_API_TOKEN=
PRIVATE_STOREFRONT_API_TOKEN=
# Optional: the showcase CMS (defaults to the live Cloud Run URL).
# CMS_URL=
