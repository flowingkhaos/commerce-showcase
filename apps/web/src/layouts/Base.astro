---
// The page shell from the Marquee Wall boards: showcase bar, nav, the wall, the dense footer
// under the giant OVRLD sign-off, and the bag. Nav and footer come from Payload's `site` doc;
// the dictionaries stand in only when that read fails (and the callouts then say "Code").
import { getShopifyScriptTags } from '@shopify/hydrogen'
import { PUBLIC_STORE_DOMAIN } from 'astro:env/server'
import CartDrawer, { BagButton } from '../components/Bag'
import Hud, { type Owner } from '../components/Hud'
import { localePath, t, type Locale } from '../i18n'
import { CMS_ADMIN, getSite, type SiteLink } from '../lib/cms'
import { marketFor } from '../lib/market'
import { getShopId } from '../lib/shopify'
import '../styles/wall.css'

interface Props {
  locale: Locale
  title: string
  description?: string | null
  /** This page's path in each language, for the language switch and hreflang. */
  paths: Record<Locale, string>
  noindex?: boolean
  cartInitial?: Parameters<typeof CartDrawer>[0]['initialData']
  /** The docs use their own reading layout instead of the wall. */
  mainClass?: string
}
const { locale, title, description, paths, noindex = false, cartInitial, mainClass = 'wrap wall' } = Astro.props
const other: Locale = locale === 'fr' ? 'en' : 'fr'
// On a Worker route (/cart, /preview) a sleeping CMS must not hold the page: wait briefly, then
// fall back. The build waits as long as a cold start needs.
const [site, shopId] = await Promise.all([
  getSite(locale, Astro.isPrerendered ? undefined : 2500).catch(() => null),
  getShopId(),
])
const { country, language } = marketFor(locale)

// Only Shopify's runtime bootstrap and Standard Actions (the cart's transport). Analytics,
// consent and perf scripts stay out until the showcase needs them.
const shopifyTags = getShopifyScriptTags({
  i18n: { country, language },
  shop: { shopId, storefrontId: '0', myshopifyDomain: PUBLIC_STORE_DOMAIN },
  shopifyAnalytics: false,
}).scripts.filter((s) => ['shopify-global-bootstrap', 'shopify-standard-actions'].includes(String(s.attributes?.id)))

const L = (path: string) => localePath(locale, path)
const owner: Owner = site ? 'Payload' : 'Code'
const nav: SiteLink[] = site
  ? (site.nav ?? [])
  : [
      { url: L('/collections/apparel'), label: t(locale, 'navApparel') },
      { url: L('/collections/equipment'), label: t(locale, 'navEquipment') },
      { url: `${L('/')}#collections`, label: t(locale, 'navCollections') },
      { url: L('/how-it-works'), label: t(locale, 'navHow') },
      { url: L('/docs'), label: t(locale, 'navDocs') },
    ]
const footer = site
  ? (site.footer ?? [])
  : [
      { heading: t(locale, 'footShop'), links: nav.slice(0, 3) },
      {
        heading: t(locale, 'footShowcase'),
        links: [
          { url: CMS_ADMIN, label: t(locale, 'openCms') },
          { url: L('/how-it-works'), label: t(locale, 'footHow') },
          { url: L('/docs'), label: t(locale, 'navDocs') },
        ],
      },
      {
        heading: t(locale, 'footRunsOn'),
        links: [
          { url: 'https://astro.build', label: 'Astro' },
          { url: 'https://payloadcms.com', label: 'Payload' },
          { url: 'https://shopify.dev', label: 'Shopify' },
        ],
      },
    ]
const footerNote = site ? site.footerNote : t(locale, 'legalNote')

// The X-ray legend counts the callouts on this page. The body renders first so the count is in
// the HTML: the switch is a checkbox, and the legend works without JavaScript.
const body = await Astro.slots.render('default')
const OWNERS: Owner[] = ['Payload', 'Shopify', 'Code']
// The chrome's own callouts: nav, footer (Payload's or the fallback's) and the bag count.
const CHROME: Record<Owner, number> = { Payload: site ? 2 : 0, Shopify: 1, Code: site ? 0 : 2 }
const counts = OWNERS.map((o) => ({
  o,
  n: CHROME[o] + (body.match(new RegExp(`class="hud[^"]*" aria-hidden="true"><b>${o}</b>`, 'g'))?.length ?? 0),
}))
const total = counts.reduce((a, c) => a + c.n, 0)
const pad = (n: number) => String(n).padStart(2, '0')
---
<!doctype html>
<html lang={t(locale, 'htmlLang')} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" hreflang={t(locale, 'htmlLang')} href={paths[locale]} />
    <link rel="alternate" hreflang={other} href={paths[other]} />
    <meta name="color-scheme" content="dark light" />
    <!-- The room is chosen before paint: dark unless the visitor turned the lights on. -->
    <script is:inline>
      try {
        if (localStorage.getItem('ovrld-mode') === 'light') document.documentElement.classList.remove('dark')
      } catch {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=JetBrains+Mono:wght@400;500;700&family=Epilogue:wght@700;800&display=swap"
    />
    <link rel="preconnect" href="https://cdn.shopify.com" />
    {shopifyTags.map(({ attributes, innerHTML }) => <script is:inline {...attributes} set:html={innerHTML ?? ''} />)}
  </head>
  <body class="ovrld">
    <div class="page">
      <a class="skip" href="#main">{t(locale, 'skip')}</a>

      <aside class="showcase" aria-label={t(locale, 'showcaseLabel')}>
        <div class="wrap showcase__in">
          <div class="showcase__slot">
            <p class="showcase__note"><b>{t(locale, 'showcaseLead')}</b>{t(locale, 'showcaseNote')}</p>
            <p class="legend">
              <span class="sr-only">{t(locale, 'xrayLegend')}</span>
              <span class="legend__bar" aria-hidden="true">{counts.flatMap(({ o, n }) => Array.from({ length: n }, () => <span data-owner={o} />))}</span>
              {counts.map(({ o, n }) => <span class="legend__key" data-owner={o}>{o === 'Code' ? t(locale, 'storeCode') : o} <b>{pad(n)}</b></span>)}
              <span class="legend__all">{t(locale, 'fields', { n: total })}</span>
            </p>
          </div>
          <div class="showcase__acts">
            <a class="sc-cms" href={CMS_ADMIN}>
              {t(locale, 'openCms')}
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
            </a>
            <label class="xray"><input type="checkbox" id="xray" role="switch" /><span class="led" aria-hidden="true"></span>{t(locale, 'xray')}<span class="xray__state" aria-hidden="true"></span></label>
          </div>
        </div>
      </aside>

      <header class="nav-wrap">
        <nav class="nav wrap" aria-label={t(locale, 'navLabel')}>
          <a class="wordmark" href={L('/')} aria-label={t(locale, 'homeLabel')}>OVRLD</a>
          <div class="nav__group" data-owner={owner}>
            <Hud o={owner} f={site ? 'site.nav' : 'nav · dictionaries, the site read failed'} at="below" />
            <ul class="nav__links">
              {nav.map((n) => <li><a href={n.url}><span class="led" aria-hidden="true" />{n.label}</a></li>)}
            </ul>
          </div>
          <div class="nav__end">
            <div class="lang" role="group" aria-label={t(locale, 'language')}>
              <a href={paths.en} lang="en" hreflang="en" aria-current={locale === 'en' ? 'page' : undefined}><span class="led" aria-hidden="true" />EN</a>
              <a href={paths.fr} lang="fr" hreflang="fr" aria-current={locale === 'fr' ? 'page' : undefined}><span class="led" aria-hidden="true" />FR</a>
            </div>
            <button
              class="mode"
              type="button"
              data-on={t(locale, 'lightsOn')}
              data-off={t(locale, 'lightsOff')}
              data-on-label={t(locale, 'lightsOnLabel')}
              data-off-label={t(locale, 'lightsOffLabel')}
              aria-label={t(locale, 'lightsOnLabel')}
            >
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="8" cy="8" r="5.5" /><path d="M8 2.5a5.5 5.5 0 0 1 0 11z" fill="currentColor" stroke="none" /></svg>
              <span class="mode__txt">{t(locale, 'lightsOn')}</span>
            </button>
            <details class="menu">
              <summary>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M2.5 5.5h11M2.5 10.5h11" /></svg>
                {t(locale, 'menu')}
              </summary>
              <div class="menu__panel">
                <ul>
                  {nav.map((n) => <li><a href={n.url}><span class="led" aria-hidden="true" />{n.label}</a></li>)}
                </ul>
                <div class="lang" role="group" aria-label={t(locale, 'language')}>
                  <a href={paths.en} lang="en" hreflang="en" aria-current={locale === 'en' ? 'page' : undefined}><span class="led" aria-hidden="true" />EN</a>
                  <a href={paths.fr} lang="fr" hreflang="fr" aria-current={locale === 'fr' ? 'page' : undefined}><span class="led" aria-hidden="true" />FR</a>
                </div>
              </div>
            </details>
            <BagButton client:load locale={locale} />
          </div>
        </nav>
      </header>

      <main id="main" class={mainClass}>
        <Fragment set:html={body} />
      </main>

      <footer class="wrap wall foot">
        <div class="row">
          <div class="tile t-util s12">
            <div class="util__go" data-owner="Code">
              <a class="foot__mark" href={L('/')} aria-label={t(locale, 'homeLabel')}>OVRLD</a>
              <div class="acts">
                <a class="cta" href={CMS_ADMIN}>{t(locale, 'openCms')} <small>{t(locale, 'openCmsSub')}</small></a>
                <a class="ghost" href={L('/docs')}><span class="led" aria-hidden="true"></span>{t(locale, 'readDocs')}</a>
              </div>
            </div>
            <div class="foot__cols" data-owner={owner}>
              <Hud o={owner} f={site ? 'site.footer' : 'footer · dictionaries, the site read failed'} />
              {
                footer.map((col) => (
                  <nav aria-label={col.heading}>
                    <h2>{col.heading}</h2>
                    <ul>{(col.links ?? []).map((l) => <li><a href={l.url}>{l.label}</a></li>)}</ul>
                  </nav>
                ))
              }
              <nav aria-label={t(locale, 'footStore')} data-owner="Code">
                <h2>{t(locale, 'footStore')}</h2>
                <ul>
                  <li><a href={L('/cart')}>{t(locale, 'bag')}</a></li>
                  <li><a href={paths[other]} lang={other} hreflang={other}>{t(locale, 'otherLang')}</a></li>
                  <li><label for="xray">{t(locale, 'xray')}</label></li>
                </ul>
              </nav>
            </div>
            <div class="legal">
              <p data-owner="Code">{t(locale, 'legal')}</p>
              {footerNote && <p data-owner={owner}>{footerNote}</p>}
            </div>
          </div>
        </div>
        <div class="row">
          <div class="tile t-mark s12" aria-hidden="true"><div class="beams"><div class="beams__sweep"></div></div><span class="mark__word">OVRLD</span></div>
        </div>
      </footer>

      <CartDrawer client:load locale={locale} initialData={cartInitial} />
    </div>

    <script is:inline>
      // X-ray stays on across pages for this visitor (works without it: the switch is a checkbox).
      ;(() => {
        const x = document.getElementById('xray')
        try {
          x.checked = localStorage.getItem('ovrld-xray') === 'on'
          x.addEventListener('change', () => localStorage.setItem('ovrld-xray', x.checked ? 'on' : 'off'))
        } catch {}
      })()
    </script>
    <script is:inline>
      // The mode toggle: html.dark is the dark room; the label names what a press does.
      ;(() => {
        const b = document.querySelector('.mode')
        const root = document.documentElement
        const sync = () => {
          const dark = root.classList.contains('dark')
          b.querySelector('.mode__txt').textContent = dark ? b.dataset.on : b.dataset.off
          b.setAttribute('aria-label', dark ? b.dataset.onLabel : b.dataset.offLabel)
        }
        sync()
        b.addEventListener('click', () => {
          root.classList.toggle('dark')
          try {
            localStorage.setItem('ovrld-mode', root.classList.contains('dark') ? 'dark' : 'light')
          } catch {}
          sync()
        })
      })()
    </script>
  </body>
</html>
