---
// A product as a wall tile (t-rel): name, spec and price over its Beam Plate photo.
import { localePath, t, type Locale } from '../i18n'
import { ghost, lowestPrice, price } from '../lib/format'
import type { Card } from '../lib/shopify'
import Plate from './Plate.astro'

interface Props {
  product: Card
  locale: Locale
  span: string
  level?: 'h2' | 'h3'
  /** Filter key (product type) for the collection chips. */
  type?: string
}
const { product: p, locale, span, level: H = 'h2', type } = Astro.props
const id = `p-${p.handle}`
const { lowest, from } = lowestPrice([p])
const amount = price(lowest, t(locale, 'moneyLocale'), true)
---
<article class:list={['tile t-rel', span]} data-type={type} aria-labelledby={id}>
  <div class="rel__copy" data-owner="Shopify">
    <H id={id} data-owner="Shopify"><a href={localePath(locale, `/products/${p.handle}`)}>{p.title}</a></H>
    {p.summary?.value && <p class="spec">{p.summary.value}</p>}
    <p class="price">
      {from && `${t(locale, 'from')} `}<span class="readout readout--sm" data-ghost={ghost(amount)}><span>{amount}</span></span>
    </p>
  </div>
  <figure class="rel__shot fig" data-owner="Shopify">
    <Plate image={p.featuredImage} title={p.title} tag={p.summary?.value} locale={locale} />
  </figure>
</article>
