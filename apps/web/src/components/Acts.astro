---
// The board's action pair: one blue pill (primary), one ghost (secondary).
import Hud from './Hud'

type Link = { label: string; url: string; style: 'primary' | 'secondary'; sub?: string }
interface Props {
  links: Link[]
  owner: 'Payload' | 'Code'
  /** The X-ray callout's field name. */
  field: string
}
const { links, owner, field } = Astro.props
---
<div class="acts" data-owner={owner}>
  <Hud o={owner} f={field} />
  {
    links.map((l) =>
      l.style === 'primary' ? (
        <a class="cta" href={l.url}>
          {l.label}
          {l.sub && <small>{l.sub}</small>}
        </a>
      ) : (
        <a class="ghost" href={l.url}>
          <span class="led" aria-hidden="true" />
          {l.label}
        </a>
      ),
    )
  }
</div>
