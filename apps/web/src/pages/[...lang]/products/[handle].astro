---
// Product: Shopify's facts plus Payload's story, prerendered for every handle in both languages.
import ProductView from '../../../components/ProductView.astro'
import { localeFromParam } from '../../../i18n'
import Base from '../../../layouts/Base.astro'
import { getProductStories } from '../../../lib/cms'
import { getHandles, getProduct } from '../../../lib/shopify'

export async function getStaticPaths() {
  return (await getHandles()).flatMap((handle) => [{ params: { lang: undefined, handle } }, { params: { lang: 'fr', handle } }])
}

const locale = localeFromParam(Astro.params.lang)!
const handle = Astro.params.handle!
const [{ product, productRecommendations }, stories] = await Promise.all([getProduct(locale, handle), getProductStories(locale)])
if (!product) throw new Error(`Shopify: product "${handle}" vanished during the build`)
// No story doc for this handle and language: the section is simply absent.
const story = stories.find((s) => s.slug === handle) ?? null
---
<Base
  locale={locale}
  title={story?.meta?.title ?? `${product.title} — OVRLD`}
  description={story?.meta?.description}
  paths={{ en: `/products/${handle}`, fr: `/fr/products/${handle}` }}
  noindex
>
  <ProductView locale={locale} product={product} recommendations={productRecommendations} story={story} />
</Base>
