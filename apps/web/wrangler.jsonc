{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deploys to the clevrstart account. There is no `account_id` here on purpose: wrangler reads
  // CLOUDFLARE_ACCOUNT_ID from the environment, so no account value lives in the public repo.
  "name": "commerce-showcase",
  // Shopify routes run before Astro's router; everything else is a prerendered asset.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
  },
  "observability": { "enabled": true },
  // Cart writes and live previews: 30 requests a minute per IP and route (src/worker.ts).
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  // Secrets, set with `wrangler secret put`: PUBLIC_STORE_DOMAIN, PRIVATE_STOREFRONT_API_TOKEN.
}
