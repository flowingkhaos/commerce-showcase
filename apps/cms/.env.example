# Postgres 18. Local: podman container showcase-cms-db (see README).
DATABASE_URL=postgres://showcase:showcase@127.0.0.1:55433/showcase
# openssl rand -hex 32
PAYLOAD_SECRET=
# Public origin of this CMS; media URLs are absolute on it.
SERVER_URL=http://localhost:4620
# The visitor door's bot check (Cloudflare Turnstile). Unset = no door. Local: Cloudflare's
# always-pass test keys below. Production: the "Showcase CMS visitor door" widget's keys.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Optional: a fine-grained GitHub token (Actions: read and write on the storefront repo). With it,
# publishing store content starts the storefront's deploy workflow.
GITHUB_DISPATCH_TOKEN=
# Optional: the Shopify app's client secret. With it, the CMS accepts Shopify's webhook calls
# (signed with that secret), logs them in webhook-events and rebuilds the storefront.
SHOPIFY_CLIENT_SECRET=
